{
  "name": "project-guandan",
  "version": "3.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "start": "node serve.mjs",
    "build": "node build.mjs",
    "test": "node --test test.mjs multiplayer.test.mjs i18n.test.mjs hand-groups.test.mjs stats.test.mjs reliability.test.mjs play-feedback.test.mjs experience.test.mjs interaction.test.mjs expert-ai.test.mjs online-bots.test.mjs card-view.test.mjs",
    "db:generate": "drizzle-kit generate",
    "format": "prettier --write \"dist/*.{js,css,html}\" \"server/*.js\" \"*.mjs\" \"ai/*.mjs\"",
    "format:check": "prettier --check \"dist/*.{js,css,html}\" \"server/*.js\" \"*.mjs\" \"ai/*.mjs\"",
    "build:demo": "node build-demo.mjs",
    "arena": "node ai/arena.mjs"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "esbuild": "0.25.12",
    "prettier": "3.6.2"
  },
  "engines": {
    "node": ">=24"
  }
}
